   ],
   "source": [
    "# Model Performance Bar Plots — Accuracy and F1 Score (All Models + Concern Per-Class)\n",
    "print(\"=\"*80)\n",
    "print(\"MODEL PERFORMANCE BAR PLOTS\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ========================================\n",
    "# Collect all metrics (using pre-computed per-class values from training)\n",
    "# ========================================\n",
    "models = ['Arrhythmia', 'Heart Damage', 'No Concern', 'Less Concern', 'Most Concern']\n",
    "colors = ['#85c1e9', '#f1948a', '#82e0aa', '#f8c471', '#d2b4de']  # Lighter variants\n",
    "\n",
    "# Accuracy values\n",
    "accuracy_means = [\n",
    "    results_arrhythmia['accuracy_mean'],\n",
    "    results_heart_damage['accuracy_mean'],\n",
    "    np.mean(results_concern_rf['per_class_accuracy'][0]),\n",
    "    np.mean(results_concern_rf['per_class_accuracy'][1]),\n",
    "    np.mean(results_concern_rf['per_class_accuracy'][2])\n",
    "]\n",
    "accuracy_stds = [\n",
    "    results_arrhythmia['accuracy_std'],\n",
    "    results_heart_damage['accuracy_std'],\n",
    "    np.std(results_concern_rf['per_class_accuracy'][0]),\n",
    "    np.std(results_concern_rf['per_class_accuracy'][1]),\n",
    "    np.std(results_concern_rf['per_class_accuracy'][2])\n",
    "]\n",
    "\n",
    "# F1 Score values\n",
    "f1_means = [\n",
    "    results_arrhythmia['f1_mean'],\n",
    "    results_heart_damage['f1_mean'],\n",
    "    np.mean(results_concern_rf['per_class_f1'][0]),\n",
    "    np.mean(results_concern_rf['per_class_f1'][1]),\n",
    "    np.mean(results_concern_rf['per_class_f1'][2])\n",
    "]\n",
    "f1_stds = [\n",
    "    results_arrhythmia['f1_std'],\n",
    "    results_heart_damage['f1_std'],\n",
    "    np.std(results_concern_rf['per_class_f1'][0]),\n",
    "    np.std(results_concern_rf['per_class_f1'][1]),\n",
    "    np.std(results_concern_rf['per_class_f1'][2])\n",
    "]\n",
    "\n",
    "# Create figure with two subplots\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "x = np.arange(len(models))\n",
    "bar_width = 0.6\n",
    "\n",
    "# ========================================\n",
    "# Plot 1: Accuracy\n",
    "# ========================================\n",
    "ax1 = axes[0]\n",
    "bars1 = ax1.bar(x, accuracy_means, bar_width, yerr=accuracy_stds, \n",
    "                color=colors, edgecolor='black', linewidth=1.2,\n",
    "                capsize=5, error_kw={'linewidth': 1.5})\n",
    "\n",
    "# Add value labels on bars\n",
    "for i, (bar, val, std) in enumerate(zip(bars1, accuracy_means, accuracy_stds)):\n",
    "    y_pos = bar.get_height() + std + 0.02 if std > 0 else bar.get_height() + 0.02\n",
    "    ax1.text(bar.get_x() + bar.get_width()/2, y_pos,\n",
    "             f'{val:.2f}', ha='center', va='bottom', fontsize=11, fontweight='bold')\n",
    "\n",
    "ax1.set_ylabel('Accuracy', fontsize=14, fontweight='bold')\n",
    "ax1.set_title('Model Accuracy', fontsize=14, fontweight='bold')\n",
    "ax1.set_xticks(x)\n",
    "ax1.set_xticklabels(models, fontsize=10, rotation=15, ha='right')\n",
    "ax1.set_ylim(0, 1.15)\n",
    "ax1.set_yticks(np.arange(0, 1.1, 0.1))\n",
    "ax1.axhline(y=0.5, color='gray', linestyle='--', linewidth=1, alpha=0.5)\n",
    "ax1.grid(axis='y', linestyle='--', alpha=0.3)\n",
    "\n",
    "# ========================================\n",
    "# Plot 2: F1 Score\n",
    "# ========================================\n",
    "ax2 = axes[1]\n",
    "bars2 = ax2.bar(x, f1_means, bar_width, yerr=f1_stds,\n",
    "                color=colors, edgecolor='black', linewidth=1.2,\n",
    "                capsize=5, error_kw={'linewidth': 1.5})\n",
    "\n",
    "# Add value labels on bars\n",
    "for i, (bar, val, std) in enumerate(zip(bars2, f1_means, f1_stds)):\n",
    "    y_pos = bar.get_height() + std + 0.02 if std > 0 else bar.get_height() + 0.02\n",
    "    ax2.text(bar.get_x() + bar.get_width()/2, y_pos,\n",
    "             f'{val:.2f}', ha='center', va='bottom', fontsize=11, fontweight='bold')\n",
    "\n",
    "ax2.set_ylabel('F1 Score', fontsize=14, fontweight='bold')\n",
    "ax2.set_title('Model F1 Score', fontsize=14, fontweight='bold')\n",
    "ax2.set_xticks(x)\n",
    "ax2.set_xticklabels(models, fontsize=10, rotation=15, ha='right')\n",
    "ax2.set_ylim(0, 1.15)\n",
    "ax2.set_yticks(np.arange(0, 1.1, 0.1))\n",
    "ax2.axhline(y=0.5, color='gray', linestyle='--', linewidth=1, alpha=0.5)\n",
    "ax2.grid(axis='y', linestyle='--', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ========================================\n",
    "# Print Summary Table\n",
    "# ========================================\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"PERFORMANCE SUMMARY\")\n",
    "print(\"=\"*80)\n",
    "summary_df = pd.DataFrame({\n",
    "    'Model': models,\n",
    "    'Accuracy': [f'{m:.2f} ± {s:.2f}' for m, s in zip(accuracy_means, accuracy_stds)],\n",
    "    'F1 Score': [f'{m:.2f} ± {s:.2f}' for m, s in zip(f1_means, f1_stds)]\n",
    "})\n",
    "display(summary_df)\n",
    "\n",
    "print(\"\\n✓ Model performance bar plots generated.\")"
   ]
