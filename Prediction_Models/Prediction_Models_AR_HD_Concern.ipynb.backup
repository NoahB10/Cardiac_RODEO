   "source": [
    "# ========================================\n",
    "# Step 14: Save Data for Graphs\n",
    "# ========================================\n",
    "print(\"=\"*80)\n",
    "print(\"SAVING DATA FOR EXTERNAL ANALYSIS (Graphs, Prism, etc.)\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# ========================================\n",
    "# Setup output directories\n",
    "# ========================================\n",
    "output_dir_cumulative = PROJECT_ROOT / 'Output' / 'Cumulative_Plot_Data'\n",
    "output_dir_performance = PROJECT_ROOT / 'Output' / 'Performance_Metrics'\n",
    "\n",
    "output_dir_cumulative.mkdir(parents=True, exist_ok=True)\n",
    "output_dir_performance.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# ========================================\n",
    "# 1. Model Performance Summary (All Models)\n",
    "# ========================================\n",
    "print(\"\\n1. Saving Model Performance Summary...\")\n",
    "\n",
    "performance_rows = [\n",
    "    {\n",
    "        'Model': 'Arrhythmia',\n",
    "        'Accuracy': results_arrhythmia['accuracy_mean'],\n",
    "        'Accuracy_Std': results_arrhythmia['accuracy_std'],\n",
    "        'F1_Score': results_arrhythmia['f1_mean'],\n",
    "        'F1_Score_Std': results_arrhythmia['f1_std']\n",
    "    },\n",
    "    {\n",
    "        'Model': 'Heart Damage',\n",
    "        'Accuracy': results_heart_damage['accuracy_mean'],\n",
    "        'Accuracy_Std': results_heart_damage['accuracy_std'],\n",
    "        'F1_Score': results_heart_damage['f1_mean'],\n",
    "        'F1_Score_Std': results_heart_damage['f1_std']\n",
    "    }\n",
    "]\n",
    "\n",
    "# Add Concern per-class\n",
    "for class_idx in [0, 1, 2]:\n",
    "    class_names = ['No Concern', 'Less Concern', 'Most Concern']\n",
    "    performance_rows.append({\n",
    "        'Model': class_names[class_idx],\n",
    "        'Accuracy': np.mean(results_concern_rf['per_class_accuracy'][class_idx]),\n",
    "        'Accuracy_Std': np.std(results_concern_rf['per_class_accuracy'][class_idx]),\n",
    "        'F1_Score': np.mean(results_concern_rf['per_class_f1'][class_idx]),\n",
    "        'F1_Score_Std': np.std(results_concern_rf['per_class_f1'][class_idx])\n",
    "    })\n",
    "\n",
    "performance_df = pd.DataFrame(performance_rows)\n",
    "performance_csv_path = output_dir_performance / 'model_performance_summary.csv'\n",
    "performance_df.to_csv(performance_csv_path, index=False)\n",
    "\n",
    "print(f\"✓ Model Performance Summary: {performance_csv_path}\")\n",
    "display(performance_df)\n",
    "\n",
    "# ========================================\n",
    "# 2. AUC-ROC Summary for All Models\n",
    "# ========================================\n",
    "print(\"\\n2. Saving AUC-ROC Summary...\")\n",
    "\n",
    "# Arrhythmia AUC\n",
    "auc_arr_df = pd.DataFrame({\n",
    "    'Fold': range(1, len(results_arrhythmia['auc_scores']) + 1),\n",
    "    'AUC_ROC': results_arrhythmia['auc_scores']\n",
    "})\n",
    "auc_arr_df.loc[len(auc_arr_df)] = ['Mean', results_arrhythmia['auc_mean']]\n",
    "auc_arr_df.loc[len(auc_arr_df)] = ['Std', results_arrhythmia['auc_std']]\n",
    "\n",
    "auc_arr_path = output_dir_performance / 'auc_arrhythmia.csv'\n",
    "auc_arr_df.to_csv(auc_arr_path, index=False)\n",
    "\n",
    "# Heart Damage AUC\n",
    "auc_hd_df = pd.DataFrame({\n",
    "    'Fold': range(1, len(results_heart_damage['auc_scores']) + 1),\n",
    "    'AUC_ROC': results_heart_damage['auc_scores']\n",
    "})\n",
    "auc_hd_df.loc[len(auc_hd_df)] = ['Mean', results_heart_damage['auc_mean']]\n",
    "auc_hd_df.loc[len(auc_hd_df)] = ['Std', results_heart_damage['auc_std']]\n",
    "\n",
    "auc_hd_path = output_dir_performance / 'auc_heart_damage.csv'\n",
    "auc_hd_df.to_csv(auc_hd_path, index=False)\n",
    "\n",
    "# Concern AUC (macro-averaged OVR)\n",
    "auc_concern_macro = []\n",
    "for fold_idx in range(3):\n",
    "    fold_auc_values = []\n",
    "    for class_idx in [0, 1, 2]:\n",
    "        if fold_idx < len(results_concern_rf['per_class_auc'][class_idx]):\n",
    "            auc_val = results_concern_rf['per_class_auc'][class_idx][fold_idx]\n",
    "            if not np.isnan(auc_val):\n",
    "                fold_auc_values.append(auc_val)\n",
    "    if fold_auc_values:\n",
    "        auc_concern_macro.append(np.mean(fold_auc_values))\n",
    "\n",
    "auc_concern_df = pd.DataFrame({\n",
    "    'Fold': range(1, len(auc_concern_macro) + 1),\n",
    "    'AUC_ROC_OVR': auc_concern_macro\n",
    "})\n",
    "auc_concern_df.loc[len(auc_concern_df)] = ['Mean', np.mean(auc_concern_macro)]\n",
    "auc_concern_df.loc[len(auc_concern_df)] = ['Std', np.std(auc_concern_macro)]\n",
    "\n",
    "auc_concern_path = output_dir_performance / 'auc_concern.csv'\n",
    "auc_concern_df.to_csv(auc_concern_path, index=False)\n",
    "\n",
    "print(f\"✓ Arrhythmia AUC: {auc_arr_path}\")\n",
    "print(f\"✓ Heart Damage AUC: {auc_hd_path}\")\n",
    "print(f\"✓ Concern AUC: {auc_concern_path}\")\n",
    "\n",
    "# Combined AUC summary\n",
    "auc_summary_rows = [\n",
    "    {'Model': 'Arrhythmia', 'AUC_Mean': results_arrhythmia['auc_mean'], 'AUC_Std': results_arrhythmia['auc_std'],\n",
    "     'Fold_1': results_arrhythmia['auc_scores'][0], 'Fold_2': results_arrhythmia['auc_scores'][1], 'Fold_3': results_arrhythmia['auc_scores'][2]},\n",
    "    {'Model': 'Heart Damage', 'AUC_Mean': results_heart_damage['auc_mean'], 'AUC_Std': results_heart_damage['auc_std'],\n",
    "     'Fold_1': results_heart_damage['auc_scores'][0], 'Fold_2': results_heart_damage['auc_scores'][1], 'Fold_3': results_heart_damage['auc_scores'][2]},\n",
    "    {'Model': 'Concern (OVR)', 'AUC_Mean': np.mean(auc_concern_macro), 'AUC_Std': np.std(auc_concern_macro),\n",
    "     'Fold_1': auc_concern_macro[0], 'Fold_2': auc_concern_macro[1], 'Fold_3': auc_concern_macro[2]}\n",
    "]\n",
    "\n",
    "auc_summary_df = pd.DataFrame(auc_summary_rows)\n",
    "auc_summary_path = output_dir_performance / 'auc_summary_all_models.csv'\n",
    "auc_summary_df.to_csv(auc_summary_path, index=False)\n",
    "\n",
    "print(f\"✓ Combined AUC Summary: {auc_summary_path}\")\n",
    "display(auc_summary_df)\n",
    "\n",
    "# ========================================\n",
    "# 3. Concern Per-Class Metrics (with Error Bars)\n",
    "# ========================================\n",
    "print(\"\\n3. Saving Concern Per-Class Metrics...\")\n",
    "\n",
    "concern_class_path = output_dir_performance / 'concern_per_class_metrics.csv'\n",
    "\n",
    "concern_per_class_rows = []\n",
    "concern_class_names = ['No Concern', 'Less Concern', 'Most Concern']\n",
    "\n",
    "for class_idx in [0, 1, 2]:\n",
    "    accuracy_mean = np.mean(results_concern_rf['per_class_accuracy'][class_idx])\n",
    "    accuracy_std = np.std(results_concern_rf['per_class_accuracy'][class_idx])\n",
    "    f1_mean = np.mean(results_concern_rf['per_class_f1'][class_idx])\n",
    "    f1_std = np.std(results_concern_rf['per_class_f1'][class_idx])\n",
    "    auc_mean = np.nanmean(results_concern_rf['per_class_auc'][class_idx])\n",
    "    auc_std = np.nanstd(results_concern_rf['per_class_auc'][class_idx])\n",
    "    \n",
    "    concern_per_class_rows.append({\n",
    "        'Concern_Level': concern_class_names[class_idx],\n",
    "        'Class_Index': class_idx,\n",
    "        'Accuracy_Mean': accuracy_mean,\n",
    "        'Accuracy_Std': accuracy_std,\n",
    "        'F1_Score_Mean': f1_mean,\n",
    "        'F1_Score_Std': f1_std,\n",
    "        'AUC_ROC_Mean': auc_mean,\n",
    "        'AUC_ROC_Std': auc_std\n",
    "    })\n",
    "\n",
    "concern_per_class_df = pd.DataFrame(concern_per_class_rows)\n",
    "concern_per_class_df.to_csv(concern_class_path, index=False)\n",
    "\n",
    "print(f\"✓ Concern Per-Class Metrics: {concern_class_path}\")\n",
    "display(concern_per_class_df)\n",
    "\n",
    "# ========================================\n",
    "# 4. Cumulative Plot Data (for Prism)\n",
    "# ========================================\n",
    "print(\"\\n4. Saving Cumulative Plot Data...\")\n",
    "print(\"   (Arrhythmia, Heart Damage, Concern No/Less/Most)\")\n",
    "\n",
    "# Get list of drugs and their actual labels\n",
    "drugs = df_raw['Drug'].astype(str).str.strip().tolist()\n",
    "\n",
    "# Get actual Concern labels for later\n",
    "concern_actual = df_raw['Concern'].astype(str).str.strip().str.lower()\n",
    "concern_map = {'no': 0, 'less': 1, 'most': 2}\n",
    "concern_numeric = concern_actual.map(concern_map)\n",
    "\n",
    "# ========================================\n",
    "# Arrhythmia Cumulative Data\n",
    "# ========================================\n",
    "top_features_arr = results_arrhythmia['feature_importances'].head(14)['Feature'].tolist()\n",
    "cumulative_arr = {}\n",
    "\n",
    "for i in range(1, len(top_features_arr) + 1):\n",
    "    features_subset = top_features_arr[:i]\n",
    "    feature_label = ' + '.join(features_subset)\n",
    "    \n",
    "    # Get predictions using these features\n",
    "    X_subset = features_df[features_subset]\n",
    "    model_arrhythmia.fit(features_df[features_df.columns], arrhythmia)\n",
    "    preds = model_arrhythmia.predict_proba(X_subset)[:, 1] * 100\n",
    "    cumulative_arr[feature_label] = preds\n",
    "\n",
    "arrhythmia_csv_path = output_dir_cumulative / 'arrhythmia_cumulative_predictions.csv'\n",
    "arrhythmia_cumulative_df = pd.DataFrame(cumulative_arr, index=drugs).T\n",
    "arrhythmia_cumulative_df.to_csv(arrhythmia_csv_path)\n",
    "\n",
    "print(f\"   ✓ Arrhythmia: {arrhythmia_csv_path}\")\n",
    "\n",
    "# ========================================\n",
    "# Heart Damage Cumulative Data\n",
    "# ========================================\n",
    "top_features_hd = results_heart_damage['feature_importances'].head(14)['Feature'].tolist()\n",
    "cumulative_hd = {}\n",
    "\n",
    "for i in range(1, len(top_features_hd) + 1):\n",
    "    features_subset = top_features_hd[:i]\n",
    "    feature_label = ' + '.join(features_subset)\n",
    "    \n",
    "    X_subset = features_df[features_subset]\n",
    "    model_heart_damage.fit(features_df[features_df.columns], heart_damage)\n",
    "    preds = model_heart_damage.predict_proba(X_subset)[:, 1] * 100\n",
    "    cumulative_hd[feature_label] = preds\n",
    "\n",
    "heart_damage_csv_path = output_dir_cumulative / 'heart_damage_cumulative_predictions.csv'\n",
    "heart_damage_cumulative_df = pd.DataFrame(cumulative_hd, index=drugs).T\n",
    "heart_damage_cumulative_df.to_csv(heart_damage_csv_path)\n",
    "\n",
    "print(f\"   ✓ Heart Damage: {heart_damage_csv_path}\")\n",
    "\n",
    "# ========================================\n",
    "# Concern Cumulative Data (Per-Class)\n",
    "# ========================================\n",
    "top_features_concern = importance_df_concern_rf.head(14)['Feature'].tolist()\n",
    "\n",
    "for class_idx in [0, 1, 2]:\n",
    "    cumulative_concern = {}\n",
    "    class_label = ['no', 'less', 'most'][class_idx]\n",
    "    \n",
    "    for i in range(1, len(top_features_concern) + 1):\n",
    "        features_subset = top_features_concern[:i]\n",
    "        feature_label = ' + '.join(features_subset)\n",
    "        \n",
    "        X_subset = features_df[features_subset]\n",
    "        model_concern_rf.fit(features_df[features_df.columns], concern)\n",
    "        preds = model_concern_rf.predict_proba(X_subset)[:, class_idx] * 100\n",
    "        cumulative_concern[feature_label] = preds\n",
    "    \n",
    "    concern_csv_path = output_dir_cumulative / f'concern_{class_label}_cumulative_predictions.csv'\n",
    "    concern_cumulative_df = pd.DataFrame(cumulative_concern, index=drugs).T\n",
    "    concern_cumulative_df.to_csv(concern_csv_path)\n",
    "    \n",
    "    print(f\"   ✓ Concern ({class_label.capitalize()}): {concern_csv_path}\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"DATA EXPORT COMPLETE\")\n",
    "print(\"=\"*80)\n",
    "print(f\"\\nOutput directory: {output_dir_performance}\")\n",
    "print(\"\\nSaved files:\")\n",
    "print(\"  - model_performance_summary.csv (with error bars)\")\n",
    "print(\"  - auc_arrhythmia.csv\")\n",
    "print(\"  - auc_heart_damage.csv\")\n",
    "print(\"  - auc_concern.csv\")\n",
    "print(\"  - auc_summary_all_models.csv\")\n",
    "print(\"  - concern_per_class_metrics.csv (with error bars)\")\n",
    "print(\"\\n✓ All data exported successfully for external analysis.\")"
   ]
  },
